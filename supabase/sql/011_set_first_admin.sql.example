-- Kein automatisches Self-Service-Admin-Signup vorgesehen. Nachdem sich der
-- erste Nutzer über /register registriert hat, dessen Rolle manuell setzen.
--
-- Seit 042_user_roles.sql liegen Rollen in user_roles (mehrere pro Person
-- möglich) - nicht mehr in profiles.role.
--
-- 1. UUID des Nutzers ermitteln:
--    SELECT id, first_name, last_name FROM profiles;
--
-- 2. Admin-Rolle vergeben (UUID ersetzen):
--    INSERT INTO user_roles (user_id, role)
--    VALUES ('<uuid-des-nutzers>', 'admin')
--    ON CONFLICT DO NOTHING;
